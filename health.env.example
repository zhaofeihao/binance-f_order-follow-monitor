# 独立告警配置，不依赖主程序能否启动。填写后保存为 health.env。
# 可以复用交易通知机器人，或使用另一个飞书机器人。
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=

# 数据抓取或心跳超过 5 分钟未更新告警。
# 实际阈值至少为主程序轮询间隔的 3 倍加 60 秒。
HEALTH_STALE_SECONDS=300
# 启动后允许建立历史基准的时间。
HEALTH_STARTUP_GRACE=180
# 启用通知通道中的记录积压超过 5 分钟告警。
HEALTH_BACKLOG_SECONDS=300
# 持续故障每 30 分钟提醒一次；故障变化和恢复会另发通知。
HEALTH_REPEAT_SECONDS=1800
# 每日健康摘要；设 0 关闭定期摘要（首次健康确认和恢复通知仍发送）。
HEALTH_REPORT_SECONDS=86400
# 可选：外部“收不到心跳即告警”服务的 HTTPS GET 地址。
# 只有本机检查正常且告警队列投递完毕才发送心跳。
# 外部服务必须部署在另一台主机，并单独配置通知接收人。
HEALTH_HEARTBEAT_URL=
