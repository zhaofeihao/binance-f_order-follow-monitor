# 复制本文件为 .env，填入真实配置；不需要 export，不要执行 source。
# 优先级：命令行参数 > 进程环境变量 > .env > 默认值。
# 飞书：两个值均为空时关闭；启用时两个值必须同时填写。
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=

# 每轮结束等待的秒数，最低 10 秒。
MONITOR_INTERVAL=30
MONITOR_MAX_PAGES=100
# 相对路径按 monitor.py 所在目录解析，与启动时工作目录无关。
MONITOR_DATA_DIR=data

# 可选 Telegram 通知，不使用则两个值保持为空。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 支持 KEY=value 或 KEY='value' / KEY="value"、空行、# 注释。
# 值为单行字面量；不支持变量替换、反斜杠转义或 shell 命令。
