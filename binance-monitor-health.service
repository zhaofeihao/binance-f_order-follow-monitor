[Unit]
Description=Independent health alerts for Binance monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=binance-monitor
Group=binance-monitor
WorkingDirectory=/opt/binance-monitor
ExecStart=/usr/bin/python3 -u /opt/binance-monitor/healthcheck.py --env-file /opt/binance-monitor/health.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Shanghai
StateDirectory=binance-monitor-health
StateDirectoryMode=0700
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/binance-monitor-health
ReadOnlyPaths=-/var/lib/binance-monitor
StandardOutput=journal
StandardError=journal
